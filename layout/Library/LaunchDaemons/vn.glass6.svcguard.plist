<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Bộ gác dịch vụ của Glass 6: chạy «g6svc boot» một lần mỗi khi máy khởi động. Có lần đổi dịch vụ chưa được xác nhận mà
     máy đã khởi động 2 lần thì g6svc tự trả các dịch vụ về như trước (docs/THIET-KE.md mục 7). Không chạy nền. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>vn.glass6.svcguard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/glass6/g6svc</string>
		<string>boot</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>UserName</key>
	<string>root</string>
</dict>
</plist>
